{
  "functions": {
    "api/sitemap.js": {
      "includeFiles": "{data/*.js,data/seo-meta.json,tierlist-data-*.js}"
    },
    "api/page.js": {
      "includeFiles": "{app.html,data/seo-meta.json,data/sets.js}"
    }
  },
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(img|tools|brand|icons|augments|plants)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
